<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <!-- Variable Management block -->
    <Properties>
        <Property name="basePath">logs</Property>
    </Properties>

    <Appenders>
        <!-- 1. Real-time Local Console Output -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- 2. Roll-over File Backup Engine (Capped at 5 historic iterations of 10MB each) -->
        <RollingFile name="FileAppender" fileName="${basePath}/automation.log"
                     filePattern="${basePath}/automation-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>

        <!-- 3. Allure Interception Hook -->
        <AllureLog4j2 name="AllureAppender"/>
    </Appenders>

    <Loggers>
        <!-- Global filtering logic set to INFO level -->
        <Root level="INFO">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="AllureAppender"/>
        </Root>
    </Loggers>
</Configuration>